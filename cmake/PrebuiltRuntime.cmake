# Only these open-source dependency libraries may enter the release SDK.
# In particular, mp2_code, aspMain and the game executable are never exported.
set(MP2_RUNTIME_TARGETS rt64 re-spirv nfd libzstd_static plume
    librecomp ultramodern miniz N64Recomp LiveRecomp SymbolLists fmt rabbitizer
    datachannel-static juice-static usrsctp)
set(MP2_PREBUILT_RUNTIME "" CACHE PATH "Verified SDK runtime libraries (empty builds dependencies locally)")

function(mp2_runtime_links output)
    set(result "")
    foreach(item IN LISTS ARGN)
        if(TARGET "${item}")
            get_target_property(real "${item}" ALIASED_TARGET)
            if(NOT real)
                set(real "${item}")
            endif()
            if(real IN_LIST MP2_RUNTIME_TARGETS)
                set(item "mp2_prebuilt_${real}")
            endif()
        elseif(item MATCHES "^\\$<LINK_ONLY:(.*)>$")
            mp2_runtime_links(inner "${CMAKE_MATCH_1}")
            set(item "$<LINK_ONLY:${inner}>")
        endif()
        list(APPEND result "${item}")
    endforeach()
    set(${output} "${result}" PARENT_SCOPE)
endfunction()

if(MP2_PREBUILT_RUNTIME)
    file(READ "${MP2_PREBUILT_RUNTIME}/runtime.json" metadata)
    foreach(field IN ITEMS compiler_id compiler_version system processor)
        string(JSON expected GET "${metadata}" "${field}")
        if(field STREQUAL "compiler_id")
            set(actual "${CMAKE_CXX_COMPILER_ID}")
        elseif(field STREQUAL "compiler_version")
            set(actual "${CMAKE_CXX_COMPILER_VERSION}")
        elseif(field STREQUAL "system")
            set(actual "${CMAKE_SYSTEM_NAME}")
        else()
            set(actual "${CMAKE_SYSTEM_PROCESSOR}")
        endif()
        if(NOT expected STREQUAL actual)
            message(FATAL_ERROR "Prebuilt runtime ${field} mismatch: ${expected} vs ${actual}")
        endif()
    endforeach()
    foreach(name IN LISTS MP2_RUNTIME_TARGETS)
        set(archive "${MP2_PREBUILT_RUNTIME}/libraries/${name}.a")
        if(NOT EXISTS "${archive}")
            message(FATAL_ERROR "Prebuilt runtime is incomplete: ${name}")
        endif()
        add_library(mp2_prebuilt_${name} STATIC IMPORTED GLOBAL)
        set_target_properties(mp2_prebuilt_${name} PROPERTIES IMPORTED_LOCATION "${archive}")
        foreach(property IN ITEMS INCLUDE_DIRECTORIES SYSTEM_INCLUDE_DIRECTORIES
                COMPILE_DEFINITIONS COMPILE_OPTIONS COMPILE_FEATURES LINK_OPTIONS LINK_DIRECTORIES)
            get_target_property(value ${name} INTERFACE_${property})
            if(value)
                set_property(TARGET mp2_prebuilt_${name} PROPERTY INTERFACE_${property} "${value}")
            endif()
        endforeach()
        get_target_property(links ${name} INTERFACE_LINK_LIBRARIES)
        if(links)
            mp2_runtime_links(links ${links})
            set_property(TARGET mp2_prebuilt_${name} PROPERTY INTERFACE_LINK_LIBRARIES "${links}")
        endif()
    endforeach()
    # Keep authored host code and all ROM-derived code local. Upstream targets
    # still define the headers/platform interfaces, but no longer feed the link.
    foreach(name IN ITEMS mp2recomp mp2_netplay netplay_test netplay_steam_test)
        if(TARGET ${name})
            foreach(property IN ITEMS LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
                get_target_property(links ${name} ${property})
                if(links)
                    mp2_runtime_links(links ${links})
                    set_property(TARGET ${name} PROPERTY ${property} "${links}")
                endif()
            endforeach()
        endif()
    endforeach()
    message(STATUS "Using verified prebuilt open-source runtime libraries")
else()
    set(manifest "")
    foreach(name IN LISTS MP2_RUNTIME_TARGETS)
        string(APPEND manifest "${name}|$<TARGET_FILE:${name}>\n")
    endforeach()
    file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/runtime-libraries.txt" CONTENT "${manifest}")
    file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/runtime-toolchain.json" CONTENT
        "{\"compiler_id\":\"${CMAKE_CXX_COMPILER_ID}\",\"compiler_version\":\"${CMAKE_CXX_COMPILER_VERSION}\",\"system\":\"${CMAKE_SYSTEM_NAME}\",\"processor\":\"${CMAKE_SYSTEM_PROCESSOR}\"}\n")
endif()
