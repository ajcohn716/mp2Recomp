# The dependency is fetched by tools/bootstrap.py at its recorded revision.
set(NO_MEDIA ON CACHE BOOL "" FORCE)
set(NO_EXAMPLES ON CACHE BOOL "" FORCE)
set(NO_TESTS ON CACHE BOOL "" FORCE)
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
add_subdirectory(libdatachannel EXCLUDE_FROM_ALL)
if(MINGW)
    # This pinned upstream file uses std::transform without <algorithm>.
    # libc++ in MSYS2 requires the direct include; keep the checkout unmodified.
    set_property(SOURCE libdatachannel/src/configuration.cpp TARGET_DIRECTORY datachannel-static
        APPEND PROPERTY COMPILE_OPTIONS -include algorithm)
endif()
# Reject incompatible authored game code before opening a session. Keep this
# platform-neutral so the same sources can connect across Linux and Windows.
file(GLOB NETPLAY_ID_FILES CONFIGURE_DEPENDS "${CMAKE_SOURCE_DIR}/src/*.cpp" "${CMAKE_SOURCE_DIR}/src/*.hpp")
list(APPEND NETPLAY_ID_FILES "${CMAKE_SOURCE_DIR}/mp2.toml" "${CMAKE_SOURCE_DIR}/dependencies.json")
set(NETPLAY_ID "mp2-netplay-v1")
foreach(FILE IN LISTS NETPLAY_ID_FILES)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${FILE}")
    file(READ "${FILE}" CONTENT)
    string(REPLACE "\r\n" "\n" CONTENT "${CONTENT}")
    string(SHA256 HASH "${CONTENT}")
    string(APPEND NETPLAY_ID "${HASH}")
endforeach()
string(SHA256 NETPLAY_ID "${NETPLAY_ID}")
file(WRITE "${CMAKE_BINARY_DIR}/netplay_build.hpp" "#pragma once\n#define MP2_NETPLAY_BUILD_ID \"${NETPLAY_ID}\"\n")
find_package(OpenSSL REQUIRED)
add_library(mp2_netplay STATIC src/netplay.cpp src/netplay_crypto.cpp src/netplay_direct.cpp src/netplay_steam.cpp)
target_include_directories(mp2_netplay PUBLIC src PRIVATE "${CMAKE_BINARY_DIR}" libdatachannel/deps/json/include)
target_link_libraries(mp2_netplay PUBLIC LibDataChannel::LibDataChannelStatic Threads::Threads OpenSSL::Crypto)
add_executable(netplay_test tests/netplay_test.cpp)
target_link_libraries(netplay_test PRIVATE mp2_netplay)

# Keep Valve's SDK external to the source-only repository. App ID 480 is the
# permanent identity for this integration, including standalone builds.
set(MP2_STEAMWORKS_SDK "" CACHE PATH "Steamworks SDK root (contains public/steam and redistributable_bin)")
if(MP2_STEAMWORKS_SDK)
    if(NOT EXISTS "${MP2_STEAMWORKS_SDK}/public/steam/steam_api.h")
        message(FATAL_ERROR "MP2_STEAMWORKS_SDK must point to the extracted Steamworks SDK")
    endif()
    if(WIN32)
        set(MP2_STEAM_RUNTIME "${MP2_STEAMWORKS_SDK}/redistributable_bin/win64/steam_api64.dll")
        set(MP2_STEAM_IMPORT "${MP2_STEAMWORKS_SDK}/redistributable_bin/win64/steam_api64.lib")
    elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64|AMD64")
        set(MP2_STEAM_RUNTIME "${MP2_STEAMWORKS_SDK}/redistributable_bin/linux64/libsteam_api.so")
    else()
        message(FATAL_ERROR "Steam netplay currently supports Linux and Windows x86-64")
    endif()
    if(NOT EXISTS "${MP2_STEAM_RUNTIME}")
        message(FATAL_ERROR "Steamworks runtime missing: ${MP2_STEAM_RUNTIME}")
    endif()
    add_library(mp2_steam_api SHARED IMPORTED GLOBAL)
    set_target_properties(mp2_steam_api PROPERTIES IMPORTED_LOCATION "${MP2_STEAM_RUNTIME}")
    if(WIN32)
        set_target_properties(mp2_steam_api PROPERTIES IMPORTED_IMPLIB "${MP2_STEAM_IMPORT}")
    endif()
    target_include_directories(mp2_netplay SYSTEM PRIVATE "${MP2_STEAMWORKS_SDK}/public")
    target_compile_definitions(mp2_netplay PRIVATE MP2_HAS_STEAMWORKS)
    target_link_libraries(mp2_netplay PUBLIC mp2_steam_api)
    message(STATUS "Steamworks netplay enabled (permanent Spacewar App ID 480)")
else()
    message(STATUS "Steamworks SDK not configured; Steam rooms report unavailable, Direct TCP remains usable")
endif()
function(mp2_copy_steam_runtime target)
    if(MP2_STEAMWORKS_SDK)
        set_property(TARGET ${target} APPEND PROPERTY BUILD_RPATH "$ORIGIN")
        add_custom_command(TARGET ${target} POST_BUILD
            COMMAND ${CMAKE_COMMAND} -E copy_if_different "${MP2_STEAM_RUNTIME}" "$<TARGET_FILE_DIR:${target}>")
        file(GENERATE OUTPUT "$<TARGET_FILE_DIR:${target}>/steam_appid.txt" CONTENT "480\n")
    endif()
endfunction()
mp2_copy_steam_runtime(netplay_test)
